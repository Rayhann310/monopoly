# ==============================================================
# MONOPOLY INDONESIA - Environment Configuration
# Salin file ini menjadi .env dan sesuaikan nilainya
# ==============================================================

# === APP SETTINGS ===
APP_NAME="Monopoly Indonesia"
APP_ENV=local
APP_DEBUG=true
# Ganti dengan URL sebenarnya, tanpa trailing slash
# Contoh lokal  : http://localhost/monopoly
# Contoh VPS    : https://monopoly.example.com
APP_URL=http://localhost/monopoly

# === DATABASE SETTINGS ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=monopoly_db
DB_USER=root
DB_PASS=

# === ADMIN SETTINGS ===
# Password default admin saat pertama kali setup
ADMIN_DEFAULT_PASSWORD=admin123

# === GAME SETTINGS ===
# Polling interval (ms) untuk realtime board update
POLLING_INTERVAL=1500
